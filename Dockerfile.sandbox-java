# Jaula de execução dos testes da stack Java (Spring Boot).
#
# É a stack mais hostil ao --network none: o Maven baixa não só as dependências
# como os próprios plugins do build. Um `mvn test` sem rede num repositório
# vazio falha antes de compilar.
#
# A solução é popular o `~/.m2` no build da imagem, rodando um projeto semente
# de verdade — `dependency:go-offline` sozinho não basta, porque não resolve os
# plugins que só são acionados durante o ciclo (surefire, jacoco, repackage). Em
# runtime o `mvn -o` transforma qualquer coisa faltando num erro imediato, em
# vez de uma espera até o timeout de rede.
#
# Com Spring, dois detalhes da semente deixaram de ser opcionais:
#
#   - ela roda `package`, não `test`. O goal `repackage` do
#     spring-boot-maven-plugin só é acionado no `package`, e o alvo do pentest
#     empacota a entrega antes de subir — sem passar por aqui, aquele primeiro
#     `mvn -o package` falharia por plugin ausente, já sem rede;
#   - ela tem um `@SpringBootTest`, não um `@Test` simples. A máquina de
#     contexto de teste do Spring arrasta um conjunto próprio de artefatos que
#     um teste JUnit puro nunca toca.
#
# Build (uma vez, e demora — baixa o repositório inteiro, agora com Spring):
#   docker build -f Dockerfile.sandbox-java -t squad-sandbox-java:latest .
FROM maven:3.9.9-eclipse-temurin-21

# Sem `--uid 1000`: a imagem do Maven já tem um usuário nesse uid, e fixá-lo
# faz o `useradd` sair com 4 e derrubar o build.
RUN useradd --create-home sandbox \
    && mkdir -p /app && chown sandbox:sandbox /app
USER sandbox

# O pom da semente é o mesmo que o executor recebe no prompt: as versões batem
# por construção, então o que foi baixado aqui é exatamente o que a entrega vai
# pedir lá.
COPY --chown=sandbox:sandbox docker/pom-referencia.xml /home/sandbox/semente/pom.xml
WORKDIR /home/sandbox/semente

# Um app Spring mínimo e um teste de contexto: rodar o ciclo até `package` é o
# que arrasta surefire, jacoco, repackage e a infraestrutura de teste do Spring
# para o repositório local.
RUN mkdir -p src/main/java/com/squad src/test/java/com/squad src/main/resources \
    && printf 'package com.squad;\nimport org.springframework.boot.SpringApplication;\nimport org.springframework.boot.autoconfigure.SpringBootApplication;\n@SpringBootApplication\npublic class SementeApplication { public static void main(String[] args) { SpringApplication.run(SementeApplication.class, args); } }\n' \
        > src/main/java/com/squad/SementeApplication.java \
    && printf 'package com.squad;\nimport org.junit.jupiter.api.Test;\nimport org.springframework.boot.test.context.SpringBootTest;\n@SpringBootTest\nclass SementeApplicationTest { @Test void contextoSobe() { } }\n' \
        > src/test/java/com/squad/SementeApplicationTest.java \
    && printf 'spring:\n  datasource:\n    url: jdbc:h2:mem:semente\n  jpa:\n    hibernate:\n      ddl-auto: create-drop\n' \
        > src/main/resources/application.yml \
    && mvn -B package \
    && test -f target/site/jacoco/jacoco.xml \
    && test -f target/app.jar \
    && rm -rf target

# A imagem base define MAVEN_CONFIG=/root/.m2, que o usuário sem privilégio não
# pode escrever. O Maven cai para `${user.home}/.m2` e funciona, mas avisa a
# cada execução e tenta criar `/root` — ruído que se confunde com erro real na
# saída que vai para o dev. Apontar explicitamente para onde o repositório de
# fato está resolve. Vai no fim do arquivo de propósito: acima, invalidaria a
# camada da semente e o build baixaria o repositório inteiro de novo.
ENV MAVEN_CONFIG=/home/sandbox/.m2

WORKDIR /app
