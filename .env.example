# OpenCode Zen — crie sua chave em https://opencode.ai/zen
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# Modelo padrão da squad (prefixo openai/ = endpoint OpenAI-compatível)
# O ID após a barra deve existir no catálogo da sua conta: confira com
#   curl https://opencode.ai/zen/v1/models -H "Authorization: Bearer $OPENCODE_API_KEY"
# Bons candidatos p/ código: openai/kimi-k2.7-code, openai/gpt-5.3-codex, openai/claude-sonnet-4-5
# Gratuitos p/ testar o fluxo sem gastar crédito: openai/deepseek-v4-flash-free, openai/mimo-v2.5-free
MODEL=openai/kimi-k2.7-code

# Onde os testes gerados por LLM são executados (Fase 6).
#   docker = sandbox efêmero, sem rede, entrega read-only (padrão; recomendado)
#   host   = subprocess na sua máquina, SEM jaula (use só se não tiver Docker)
# Requer a imagem, construída uma vez com:
#   docker build -f Dockerfile.sandbox -t squad-sandbox:latest .
TEST_RUNNER=docker

# Cobertura mínima da entrega pelos testes (Fase 7). Testes verdes abaixo
# deste piso indicam suíte que não exercita o código: o QA reescreve os
# testes, sem pagar outra rodada de desenvolvimento.
COBERTURA_MINIMA=70

# Piso por módulo: o agregado sozinho deixa passar a suíte que testa muito o
# que é fácil e ignora o arquivo central do pedido (visto em execução real —
# 89% no total com 51% no módulo da API). Vale para o arquivo menos coberto.
COBERTURA_MINIMA_MODULO=60

# Executor do nó de desenvolvimento (Fase 5): quem escreve o código.
#   opencode = OpenCode CLI em modo headless (padrão; requer o CLI instalado)
#   crews    = crews CrewAI (backend -> integração -> tech lead), sem CLI
DEV_EXECUTOR=opencode

# Teto por rodada de desenvolvimento, em segundos. Rodadas de correção ficam
# mais caras conforme o código cresce: numa API multi-arquivo, a terceira
# rodada estourou os 900s originais. O teto protege contra CLI travado, não
# contra trabalho legítimo demorado.
TIMEOUT_DESENVOLVIMENTO=1800

# Modelo usado pelo OpenCode CLI (opcional). Vazio = modelo padrão da conta.
# Formato provider/model, ex.: opencode/claude-sonnet-5
OPENCODE_RUN_MODEL=

# Deploy real (Fase 4): repositório GitHub que recebe as entregas, no formato
# owner/repo. Cada execução aprovada vira uma branch entrega/<thread_id>.
# Opcional: sem esta variável, o deploy faz apenas o commit local no workspace.
# Requer git autenticado no GitHub na máquina (ex.: via gh auth login).
DEPLOY_REPO=
