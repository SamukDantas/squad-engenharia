# OpenCode Zen — crie sua chave em https://opencode.ai/zen
OPENCODE_API_KEY=
# Atenção ao endpoint: /zen/v1 é o Zen (catálogo completo, inclui os
# gratuitos); /zen/go/v1 é a assinatura Go, que NÃO serve modelo gratuito e
# tem cota mensal própria (item 26 do RESILIENCIA.md). Apontar a squad para o
# Go é o caminho mais fácil de gastar cota em experimento.
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# Modelo padrão da squad (prefixo openai/ = endpoint OpenAI-compatível)
# O ID após a barra deve existir no catálogo da sua conta: confira com
#   curl https://opencode.ai/zen/v1/models -H "Authorization: Bearer $OPENCODE_API_KEY"
# Bons candidatos p/ código: openai/kimi-k2.7-code, openai/gpt-5.3-codex, openai/claude-sonnet-4-5
# Gratuitos p/ experimentar o fluxo sem gastar crédito: openai/laguna-s-2.1-free,
# openai/deepseek-v4-flash-free, openai/mimo-v2.5-free, openai/hy3-free
# Vale para os agentes SEM ferramenta (planejamento, revisão) e para os guards.
MODEL=openai/kimi-k2.7-code

# Modelo dos agentes COM ferramenta de arquivo — hoje o QA que escreve os
# testes. Ferramenta reprecifica o requisito de modelo (item 12 do
# RESILIENCIA.md): um gratuito devolveu a suíte inteira como markdown na
# resposta, sem nunca chamar escrever_arquivo, e o nó concluiu com o
# workspace vazio — 855s pagos por texto. Vazio = mesmo modelo do MODEL,
# o que só é seguro se MODEL já suportar tool calling.
MODEL_FERRAMENTAS=

# Onde os testes gerados por LLM são executados (Fase 6).
#   docker = sandbox efêmero, sem rede, entrega read-only (padrão; recomendado)
#   host   = subprocess na sua máquina, SEM jaula (use só se não tiver Docker)
# Requer a imagem, construída uma vez com:
#   docker build -f Dockerfile.sandbox-python -t squad-sandbox-python:latest .
# (nextjs e java têm as suas: Dockerfile.sandbox-nextjs, Dockerfile.sandbox-java)
TEST_RUNNER=docker

# Cobertura mínima da entrega pelos testes (Fase 7). Testes verdes abaixo
# deste piso indicam suíte que não exercita o código: o QA reescreve os
# testes, sem pagar outra rodada de desenvolvimento.
COBERTURA_MINIMA=70

# Piso por módulo: o agregado sozinho deixa passar a suíte que testa muito o
# que é fácil e ignora o arquivo central do pedido (visto em execução real —
# 89% no total com 51% no módulo da API). Vale para o arquivo menos coberto.
COBERTURA_MINIMA_MODULO=60

# Executor do nó de desenvolvimento (Fase 5): quem escreve o código.
#   opencode = OpenCode CLI em modo headless (padrão; requer o CLI instalado)
#   crews    = crews CrewAI (backend -> integração -> tech lead), sem CLI
DEV_EXECUTOR=opencode

# Pentest da entrega viva (Fase 8): sobe a entrega e a ataca num sandbox Docker
# isolado (rede --internal, sem egress), roteando pelo resultado com
# auto-remediação. Desligado por padrão — 1 liga. Requer as duas imagens:
#   docker build -f Dockerfile.target-python -t squad-target-python:latest .
#   docker build -f Dockerfile.pentest -t squad-pentest:latest .
PENTEST_HABILITADO=0
# Severidade mínima que reprova e reabre o laço (info<low<medium<high<critical).
# Abaixo do piso, o achado vai ao gate humano mas não custa uma rodada.
PENTEST_SEVERIDADE_BLOQUEIO=high
# Teto do ataque inteiro, em segundos (scan é lento; estourar = inconclusivo).
TIMEOUT_PENTEST=600
# ZAP baseline (Java, pesado): 1 liga, se a imagem foi construída com ele.
PENTEST_ZAP=0

# Teto por rodada de desenvolvimento, em segundos. Rodadas de correção ficam
# mais caras conforme o código cresce: numa API multi-arquivo, a terceira
# rodada estourou os 900s originais. O teto protege contra CLI travado, não
# contra trabalho legítimo demorado.
TIMEOUT_DESENVOLVIMENTO=1800

# Teto por requisição ao provedor de LLM, em segundos. Sem ele, uma resposta
# que nunca chega trava o nó para sempre — medido: 9h paradas no guard com
# 0,2% de CPU. Retry, checkpoint e circuit breaker não pegam esse caso: todos
# pressupõem que a chamada retorna.
# Atenção: o SDK por baixo repete internamente, então o tempo real até
# desistir é ~5,5x este valor (300s ≈ 27 min).
TIMEOUT_LLM=300

# Modelo usado pelo OpenCode CLI (opcional). Vazio = modelo padrão da conta.
# Formato provider/model — provider `opencode` = Zen, `opencode-go` = Go.
# Liste os disponíveis com: opencode models
# Ex.: opencode/claude-sonnet-5 (pago) ou opencode/laguna-s-2.1-free (grátis).
# Sem esta variável o nó de desenvolvimento usa o padrão da conta, que pode
# ser um modelo pago mesmo com a squad configurada num gratuito.
OPENCODE_RUN_MODEL=

# Servidores MCP que o executor OpenCode enxerga, separados por vírgula.
# O `--dir` não isola a configuração: sem esta jaula o CLI herda o
# opencode.json global da máquina. Medido numa instalação real: 15 MCP
# habilitados, entre eles controle do SO, Docker (que gerencia o próprio
# squad-sandbox) e GitHub com token de push — dentro do nó que o README
# descreve como confinado ao workspace.
# Vazio = nenhum, que é o suficiente para escrever Python num workspace
# isolado. `context7` é o único com argumento a favor (docs de lib reduzem
# alucinação de API); meça antes de ligar.
OPENCODE_MCP_PERMITIDOS=

# Skills globais do OpenCode visíveis ao executor.
#   0 = desligadas (padrão)
#   1 = carrega as skills instaladas na máquina
# Medido em 3 execuções por braço, mesmo pedido, entrega idêntica nas 6:
#
#   preâmbulo por rodada    104.798 tokens  ->  10.543   (-90%)
#   custo por rodada        $0,1658         ->  $0,0367  (-78%)
#
# As 623 skills instaladas eram 90% do que o executor lia antes de chegar na
# spec, e o grafo pode gastar até 3 rodadas. Se um pedido específico precisar
# de uma skill, ligue aqui — carregar 623 para talvez usar uma não se paga.
OPENCODE_SKILLS=0

# Stack da entrega: python, nextjs ou java. A flag `--stack` do main.py tem
# precedência sobre esta variável, e a escolha fica gravada no checkpoint —
# uma retomada usa a stack da execução, não a que estiver aqui na hora.
STACK=python

# Verificação visual (Fase 9): renderiza a entrega num Chromium isolado e mede
# o contraste real nos temas claro e escuro. Desligado por padrão -- exige a
# imagem construída uma vez:
#   docker build -f Dockerfile.visual -t squad-visual:latest .
VISUAL_HABILITADO=0
# Teto do nó inteiro, em segundos (o primeiro start do navegador é o lento).
TIMEOUT_VISUAL=180

# Deploy real (Fase 4): conta GitHub que hospeda os repositórios de entrega.
# Um projeto, um repositório: o deploy cria <DEPLOY_OWNER>/<slug do pedido> se
# ele ainda não existir. Opcional: sem esta variável, o deploy faz apenas o
# commit local no workspace.
# Requer o GitHub CLI (gh) autenticado na máquina, com a conta ativa sendo
# DEPLOY_OWNER ou alguém que administre a org dona -- 'gh auth switch --user'
# troca a conta ativa quando há mais de uma autenticada.
DEPLOY_OWNER=

# Visibilidade dos repositórios criados: private (padrão) ou public.
DEPLOY_VISIBILIDADE=private
